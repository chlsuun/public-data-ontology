discovery:i-graduate a discovery:Indicator ;
    rdfs:label "대학 졸업 후 지역 이동" .

discovery:i-neet a discovery:Indicator ;
    rdfs:label "청년 NEET 비율" .

discovery:q-employment a discovery:QueryTopic ;
    rdfs:label "청년 고용과 관련된 데이터를 찾아줘" .

discovery:q-housing a discovery:QueryTopic ;
    rdfs:label "주거비와 관련된 데이터를 찾아줘" .

discovery:q-migration a discovery:QueryTopic ;
    rdfs:label "청년 인구 유출과 관련된 데이터를 찾아줘" .

discovery:d-oecd-unemployment a dcat:Dataset ;
    rdfs:label "Monthly unemployment rates" ;
    dct:source <https://data-explorer.oecd.org/vis?df%5Bag%5D=OECD.SDD.TPS&df%5Bds%5D=dsDisseminateFinalDMZ&df%5Bid%5D=DSD_LFS%40DF_IALFS_UNE_M&df%5Bvs%5D=1.0&dq=..._Z.Y._T.Y_GE15..M&lo=13&lom=LASTNPERIODS&ly%5Bcl%5D=TIME_PERIOD&ly%5Brw%5D=REF_AREA&pd=%2C&to%5BTIME_PERIOD%5D=false&vw=ov> ;
    discovery:providedBy discovery:provider-oecd .

<https://example.org/public-data-discovery/evidence/oecd-unemployment-web> a prov:Entity ;
    dct:source <https://www.oecd.org/en/data/indicators/youth-unemployment-rate.html> .

<https://example.org/public-data-discovery/evidence/wb-employment> a prov:Entity ;
    dct:source <https://api.worldbank.org/v2/indicator/SL.EMP.1524.SP.ZS?format=json> .

<https://example.org/public-data-discovery/evidence/wb-unemployment> a prov:Entity ;
    dct:source <https://api.worldbank.org/v2/indicator/SL.UEM.1524.ZS?format=json> .

discovery:i-employment a discovery:Indicator ;
    rdfs:label "청년 고용률" ;
    discovery:availableFrom discovery:d-wb-employment .

discovery:i-house a discovery:Indicator ;
    rdfs:label "주택가격지수" ;
    discovery:availableFrom discovery:d-oecd-housing .

discovery:i-in a discovery:Indicator ;
    rdfs:label "전입자수" .

discovery:i-net a discovery:Indicator ;
    rdfs:label "순이동자수" ;
    discovery:availableFrom discovery:d-kosis-net .

discovery:i-out a discovery:Indicator ;
    rdfs:label "전출자수" .

discovery:i-rent a discovery:Indicator ;
    rdfs:label "주택 임대료 지수" .

discovery:QueryTopic a owl:Class ;
    rdfs:label "질문 주제"@ko .

discovery:d-kosis-flows a dcat:Dataset ;
    rdfs:label "시군구/성/연령(5세)별 이동자수" ;
    dct:source <https://kosis.kr/statHtml/statHtml.do?orgId=101&tblId=DT_1B26001> ;
    discovery:providedBy discovery:provider-mods .

discovery:d-kosis-net a dcat:Dataset ;
    rdfs:label "시군구/성/연령(5세)별 순이동자수" ;
    dct:source <https://kosis.kr/statHtml/statHtml.do?orgId=101&tblId=DT_1B26002> ;
    discovery:providedBy discovery:provider-mods .

discovery:d-wb-employment a dcat:Dataset ;
    rdfs:label "Employment to population ratio, ages 15-24, total (%) (modeled ILO estimate)" ;
    dct:source <https://data.worldbank.org/indicator/SL.EMP.1524.SP.ZS> ;
    discovery:providedBy discovery:provider-wb .

discovery:d-wb-unemployment a dcat:Dataset ;
    rdfs:label "Unemployment, youth total (% of total labor force ages 15-24) (modeled ILO estimate)" ;
    dct:source <https://data.worldbank.org/indicator/SL.UEM.1524.ZS> ;
    discovery:providedBy discovery:provider-wb .

<https://example.org/public-data-discovery/evidence/oecd-housing-web> a prov:Entity ;
    dct:source <https://www.oecd.org/en/data/indicators/housing-prices.html> .

discovery:i-unemployment a discovery:Indicator ;
    rdfs:label "청년 실업률" ;
    discovery:availableFrom discovery:d-wb-unemployment .

discovery:c-housing a skos:Concept ;
    rdfs:label "주거" .

discovery:d-oecd-housing a dcat:Dataset ;
    rdfs:label "Analytical house price indicators" ;
    dct:source <https://data-explorer.oecd.org/vis?df%5Bag%5D=OECD.ECO.MPD&df%5Bds%5D=dsDisseminateFinalDMZ&df%5Bid%5D=DSD_AN_HOUSE_PRICES%40DF_HOUSE_PRICES&df%5Bvs%5D=1.0&dq=.Q.RHP.&lc=en&pd=%2C&pg=0&snb=1&tm=DF_HOUSE_PRICES&to%5BTIME_PERIOD%5D=false&vw=tb> ;
    discovery:providedBy discovery:provider-oecd .

discovery:provider-mods a foaf:Organization ;
    rdfs:label "국가데이터처" .

discovery:provider-oecd a foaf:Organization ;
    rdfs:label "OECD" .

discovery:provider-wb a foaf:Organization ;
    rdfs:label "World Bank" .

discovery:c-education a skos:Concept ;
    rdfs:label "교육·노동시장 이행" .

<https://example.org/public-data-discovery/evidence/kosis-migration> a prov:Entity ;
    dct:source <https://kosis.kr/serviceInfo/newContrainDataDetail.do?boardIdx=1976003&boardOrgId=101> .

<https://example.org/public-data-discovery/evidence/kosis-table-access> a prov:Entity ;
    dct:source <https://kosis.kr/statHtml/statHtml.do?orgId=101&tblId=DT_1B26001> .

discovery:c-employment a skos:Concept ;
    rdfs:label "고용" .

discovery:c-migration a skos:Concept ;
    rdfs:label "인구이동" .

discovery:Indicator a owl:Class ;
    rdfs:label "측정 지표"@ko .

<https://example.org/public-data-discovery/evidence/user-requirements> a prov:Entity .
