    },
    {
      "predicate": "reportedProvider",
      "source": "CatalogRegistration",
      "target": "ReportedOrganization",
      "evidence": "목록의 기관 코드·명칭; 포털 간 기관 동일성 미확정"
    },
    {
      "predicate": "declaresOutputToken",
      "source": "CatalogRegistration",
      "target": "DeclaredFieldToken",
      "evidence": "출력결과 문자열 분리; 구분자 검증 전 후보"
    },
    {
      "predicate": "hasDocumentedField",
      "source": "CatalogRegistration",
      "target": "DocumentedField",
      "evidence": "공식 공개 칼럼 명세; 실제 값 검사 전"
    },
    {
      "predicate": "supportedBy",
      "source": "CatalogRegistration|DocumentedField",
      "target": "SourceEvidence",
      "evidence": "URL·조회일·SHA256·원문 위치"
    },
    {
      "predicate": "sameAs|joinableWith|statisticallyAssociatedWith",
      "status": "not_asserted",
      "requires": "관계별 사람 검토·조건·분석 근거"
    },
    {
      "predicate": "hasCandidateHeader",
      "source": "CatalogRegistration",
      "target": "ObservedHeaderCandidate",
      "evidence": "공개 CSV 첫 레코드, 공식 파일 미리보기 또는 공개 목록 화면의 표 머리글과 원문 위치·SHA256. 화면 제어 항목이 포함될 수 있어 정식 칼럼 명세 및 의미 검증 전 후보로 보존한다."
    },
    {
      "predicate": "referencesExternalPage",
      "source": "CatalogRegistration",
      "target": "ExternalPageReference",
      "evidence": "공식 상세 페이지에 실제 표시된 외부 링크; 동일 자료 여부는 미확정"
    },
    {
      "predicate": "referencesCodeList",
      "source": "CatalogRegistration",
      "target": "CodeList",
      "evidence": "공식 API 명세의 특정 요청/응답 인자 행에서 코드표로 연결된 팝업 참조; 포털 간 코드 체계 동일성은 미확정"
    },
    {
      "predicate": "advertisesPublicToolContract",
      "source": "Portal",
      "target": "PublicToolContract",
      "evidence": "공식 MCP 주소에서 tools/list로 공개한 도구 계약; 입력 스키마는 데이터셋 응답 칼럼과 별도이며 실제 도구 미실행"
