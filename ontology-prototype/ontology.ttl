ex:condition a owl:DatatypeProperty .

ex:decision a owl:DatatypeProperty .

ex:join-bus-living a ex:JoinAssessment ;
    rdfs:label "join-bus-living"@ko ;
    ex:blocker "공간 대응표 없음"@ko,
        "관측 단위 확인 전"@ko,
        "인과관계를 결론 낼 수 없음"@ko ;
    ex:condition "버스정류장 좌표와 행정동 경계 자료를 추가 확보"@ko,
        "생활인구의 일 대표값 산출 기준을 정함"@ko,
        "측정 범위·국적 범위 차이를 표시"@ko ;
    ex:joinKey "관측 날짜·집계 기준"@ko,
        "정류장→행정동 대응표"@ko ;
    ex:leftDataset ex:ds-bus-daily ;
    ex:purpose "지역별 버스 이용과 생활인구의 관계 탐색"@ko ;
    ex:rightDataset ex:ds-living-new ;
    ex:sourceEvidence ex:S2,
        ex:S6,
        ex:S7 ;
    ex:status "requires_validation" .

ex:join-bus-time a ex:JoinAssessment ;
    rdfs:label "join-bus-time"@ko ;
    ex:blocker "현재 원본 컬럼 및 중복 키 검증 전"@ko ;
    ex:condition "양쪽 키 체계·기간·포함 범위를 검증"@ko,
        "월별 시간대 자료의 합계 정의를 확인"@ko,
        "일별 자료를 월 단위로 먼저 집계"@ko ;
    ex:joinKey "기준 월"@ko,
        "노선 식별자"@ko,
        "정류장 식별자"@ko ;
    ex:leftDataset ex:ds-bus-daily ;
    ex:purpose "일별 자료를 월 합계로 집계한 뒤 시간대 자료와 대조"@ko ;
    ex:rightDataset ex:ds-bus-hourly ;
    ex:sourceEvidence ex:S2,
        ex:S3 ;
    ex:status "requires_validation" .

ex:join-living-versions a ex:JoinAssessment ;
    rdfs:label "join-living-versions"@ko ;
    ex:blocker "같은 컬럼명만으로 이어 붙일 수 없음"@ko,
        "동일한 시계열이라는 근거 없음"@ko ;
    ex:condition "겹치는 기간의 추계 방법·수치 차이를 검증"@ko,
        "방법 변경 시점을 결과에 표시"@ko ;
    ex:joinKey "공통 시점"@ko,
        "동일 공간 구역"@ko ;
    ex:leftDataset ex:ds-living-old ;
    ex:purpose "장기 생활인구 추세 분석"@ko ;
    ex:rightDataset ex:ds-living-new ;
    ex:sourceEvidence ex:S5,
        ex:S6,
        ex:S7 ;
    ex:status "blocked_for_blind_append" .

ex:join-populations a ex:JoinAssessment ;
    rdfs:label "join-populations"@ko ;
    ex:blocker "KOSIS 지역 코드 원본 확인 전"@ko,
        "성별·대상 범위 비교 전"@ko,
        "이용 조건 확인 필요"@ko ;
    ex:condition "같은 기준일의 구역·코드 체계로 정렬"@ko,
        "국적·대상 범위 확인; 양쪽 값을 합산하지 않음"@ko,
        "생활인구 대표 시각 또는 기간 평균을 명시"@ko ;
    ex:joinKey "기준 월"@ko,
        "행정동→시군구 대응표"@ko ;
    ex:leftDataset ex:ds-living-new ;
    ex:purpose "지역의 존재 인구와 등록 인구를 구별해 비교"@ko ;
    ex:rightDataset ex:ds-resident ;
    ex:sourceEvidence ex:S6,
        ex:S7,
        ex:S8,
        ex:S9 ;
    ex:status "requires_validation" .

ex:join-subway-living a ex:JoinAssessment ;
    rdfs:label "join-subway-living"@ko ;
    ex:blocker "역 위치·공간 대응표 없음"@ko,
        "일별 자료로 출근시간을 직접 조회할 수 없음"@ko ;
    ex:condition "역 위치와 시점별 경계 자료를 추가 확보"@ko,
        "일별 지하철 자료의 시간대 제약을 반영"@ko,
        "주변 반경 또는 행정동 중 분석 공간을 먼저 정의"@ko ;
    ex:joinKey "공통 분석 기간"@ko,
        "역→공간 구역 대응표"@ko ;
    ex:leftDataset ex:ds-subway-daily ;
    ex:purpose "역 주변 대중교통 이용과 생활인구 비교"@ko ;
    ex:rightDataset ex:ds-living-new ;
    ex:sourceEvidence ex:S4,
        ex:S7 ;
    ex:status "requires_validation" .

