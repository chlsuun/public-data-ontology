ex:rule-current a ex:PolicyRule ;
    rdfs:label "생산 종료 자료를 최신 자료로 추천하지 않음"@ko ;
    ex:condition "lifecycle = production_ended AND request = latest"@ko ;
    ex:decision "exclude_from_latest; 후속 자료 후보와 검증 조건 안내"@ko .

