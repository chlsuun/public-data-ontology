    rdfs:label "주제 관련성과 조인 가능성을 구분"@ko ;
    ex:condition "join_assessment != validated"@ko ;
    ex:decision "연결 조건만 안내; 자동 조인 허가하지 않음"@ko .

ex:rule-license a ex:PolicyRule ;
    rdfs:label "이용 조건 미확인을 허용으로 바꾸지 않음"@ko ;
